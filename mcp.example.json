{
  "_comment": "Copy to your project as .mcp.json (or use `claude mcp add`). Replace ALL <PLACEHOLDER> values. NEVER commit real keys.",
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "memory": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "<PATH_TO_ALLOW e.g. /Users/you/projects>"]
    }
  }
}
